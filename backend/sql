-- ============================================
-- ROLES
-- ============================================

CREATE TABLE roles (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE,
    descripcion TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- USUARIOS
-- ============================================

CREATE TABLE usuarios (
    id SERIAL PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    puesto VARCHAR(100),
    role_id INT NOT NULL REFERENCES roles(id) ON DELETE RESTRICT,
    activo BOOLEAN DEFAULT TRUE,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- GRUPOS
-- ============================================

CREATE TABLE grupos (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT,
    ubicacion VARCHAR(150) DEFAULT 'DII',
    estado VARCHAR(20) DEFAULT 'Activo',
    fecha_creacion DATE DEFAULT CURRENT_DATE
);

-- ============================================
-- MIEMBROS DE GRUPOS
-- ============================================

CREATE TABLE miembros_grupos (
    grupo_id INT REFERENCES grupos(id) ON DELETE CASCADE,
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
    es_administrador BOOLEAN DEFAULT FALSE,
    PRIMARY KEY (grupo_id, usuario_id)
);

-- ============================================
-- EQUIPOS
-- ============================================

CREATE TABLE equipos (
    id VARCHAR(50) PRIMARY KEY,
    ubicacion VARCHAR(150) NOT NULL,
    estado VARCHAR(30) DEFAULT 'apagado',
    grupo_id INT REFERENCES grupos(id) ON DELETE SET NULL,
    ultima_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- TAREAS
-- ============================================

CREATE TABLE tareas (
    id SERIAL PRIMARY KEY,
    titulo VARCHAR(150) NOT NULL,
    descripcion TEXT NOT NULL,
    grupo_id INT REFERENCES grupos(id) ON DELETE CASCADE,
    fecha_limite DATE NOT NULL,
    estado VARCHAR(30) DEFAULT 'Pendiente',
    extra_info VARCHAR(100),
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- HISTORIAL DE SESIONES
-- ============================================

CREATE TABLE historial_sesiones (
    id SERIAL PRIMARY KEY,
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
    evento VARCHAR(100) NOT NULL,
    dispositivo VARCHAR(150) NOT NULL,
    hora VARCHAR(50) NOT NULL,
    fecha_registro DATE DEFAULT CURRENT_DATE
);

-- ============================================
-- IMPRESIONES
-- ============================================

CREATE TABLE trabajos_impresion (
    id SERIAL PRIMARY KEY,
    usuario_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    impresora VARCHAR(100) NOT NULL,
    ip_impresora VARCHAR(45) NOT NULL,
    archivo VARCHAR(255) NOT NULL,
    tamano VARCHAR(30) NOT NULL,
    estado VARCHAR(30) NOT NULL,
    fecha_envio DATE DEFAULT CURRENT_DATE,
    hora_envio VARCHAR(20) NOT NULL
);

-- ============================================
-- ARCHIVOS ENVIADOS
-- ============================================

CREATE TABLE archivos_enviados (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL,
    tamano VARCHAR(30) NOT NULL,
    remitente_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    grupo_destino_id INT REFERENCES grupos(id) ON DELETE CASCADE,
    fecha_envio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    estado VARCHAR(30) DEFAULT 'Enviado'
);

-- ============================================
-- TICKETS
-- ============================================

CREATE TABLE tickets (
    id SERIAL PRIMARY KEY,
    area VARCHAR(100) NOT NULL,
    equipo_id VARCHAR(50) REFERENCES equipos(id) ON DELETE SET NULL,

    usuario_id INT NOT NULL REFERENCES usuarios(id),

    descripcion TEXT NOT NULL,
    estado VARCHAR(30) DEFAULT 'Abierto',
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================
-- EVIDENCIAS DE TICKETS
-- ============================================

CREATE TABLE evidencias_tickets (
    id SERIAL PRIMARY KEY,
    ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
    ruta_archivo VARCHAR(500) NOT NULL,
    nombre_original VARCHAR(255) NOT NULL,
    tamano_mb NUMERIC(5,2),
    fecha_subida TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

