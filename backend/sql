-- 1. TABLA: ROLES
-- Define los privilegios dentro de la plataforma (administrador, usuario/analista)
CREATE TABLE roles (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE, -- 'admin', 'user'
    descripcion TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. TABLA: USUARIOS
-- Almacena las credenciales y perfiles del personal de la DII
CREATE TABLE usuarios (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE, -- Correo institucional @ipn.mx
    password VARCHAR(255) NOT NULL,    -- Contraseña encriptada
    puesto VARCHAR(100),                -- 'Analista de Red', 'Soporte Técnico', etc.
    role_id INT REFERENCES roles(id) ON DELETE RESTRICT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. TABLA: GRUPOS
-- Catálogo maestro de grupos de trabajo (antiguo y nuevo catálogo unificado)
CREATE TABLE grupos (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE, -- 'Analistas', 'Redes Avanzadas', etc.
    description TEXT,
    ubicacion VARCHAR(150) DEFAULT 'DII', -- 'Edificio Central - Planta Alta'
    status VARCHAR(20) DEFAULT 'Activo',  -- 'Activo', 'Inactivo', 'Temporal'
    fecha_creacion DATE DEFAULT CURRENT_DATE
);

-- 4. TABLA INTERMEDIA: MIEMBROS_GRUPOS
-- Relación de muchos a muchos para saber qué analistas pertenecen a qué grupos
CREATE TABLE miembros_grupos (
    grupo_id INT REFERENCES grupos(id) ON DELETE CASCADE,
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
    es_administrador BOOLEAN DEFAULT FALSE, -- Por si dentro de un grupo hay un líder
    PRIMARY KEY (grupo_id, usuario_id)
);

-- 5. TABLA: EQUIPOS (TERMINALES)
-- Inventario físico del parque computacional vinculado a la topología en árbol
CREATE TABLE equipos (
    id VARCHAR(50) PRIMARY KEY, -- 'PC-SIS-01', 'PC-CON-02'
    ubicacion VARCHAR(150) NOT NULL,
    estado VARCHAR(30) DEFAULT 'apagado', -- 'encendido', 'apagado', 'sin-conexion'
    grupo_id INT REFERENCES grupos(id) ON DELETE SET NULL, -- Departamento o entorno al que pertenece
    ultima_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 6. TABLA: TAREAS (FLUJO ESTILO TEAMS)
-- Almacena las actividades asignadas por el Admin a los grupos y visibles en Pendientes
CREATE TABLE tareas (
    id SERIAL PRIMARY KEY,
    title VARCHAR(150) NOT NULL,
    description TEXT NOT NULL,
    grupo_id INT REFERENCES grupos(id) ON DELETE CASCADE, -- Grupo entero asignado
    date_limite DATE NOT NULL,                             -- Fecha de vencimiento
    status VARCHAR(30) DEFAULT 'Pendiente',                -- 'Pendiente', 'En progreso', 'Completada', 'Vencida'
    extra_info VARCHAR(100),                               -- 'Vence en 2 días', 'Completada el 19/05'
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 7. TABLA: HISTORIAL_SESIONES
-- Registro de logs de acceso diario requerido en el panel de Analista
CREATE TABLE historial_sesiones (
    id SERIAL PRIMARY KEY,
    usuario_id INT REFERENCES usuarios(id) ON DELETE CASCADE,
    evento VARCHAR(100) NOT NULL,       -- 'Inicio de Sesión Exitoso', 'Cierre Automatizado'
    dispositivo VARCHAR(150) NOT NULL,  -- 'PC-SIS-02 (192.168.1.54)'
    hora VARCHAR(50) NOT NULL,          -- 'Hoy — 10:24 AM' (o timestamp)
    fecha_registro DATE DEFAULT CURRENT_DATE
);

-- 8. TABLA: TRABAJOS_IMPRESION
-- Spooler de auditoría de impresiones perimetrales
CREATE TABLE trabajos_impresion (
    id SERIAL PRIMARY KEY,
    usuario_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    impresora VARCHAR(100) NOT NULL,   -- 'HP LaserJet Pro M404dw'
    ip_impresora VARCHAR(45) NOT NULL, -- '192.168.1.45'
    archivo VARCHAR(255) NOT NULL,     -- 'Reporte_Mensual_Mayo.pdf'
    tamano VARCHAR(30) NOT NULL,       -- '2.45 MB' o '6.25 GB'
    estado VARCHAR(30) NOT NULL,       -- 'Completado', 'Bloqueado', 'En proceso'
    fecha_envio DATE DEFAULT CURRENT_DATE,
    hora_envio VARCHAR(20) NOT NULL    -- '10:24 AM'
);

-- 9. TABLA: ARCHIVOS_ENVIADOS
-- Auditoría de distribución y envío de documentos compartidos globales
CREATE TABLE archivos_enviados (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(255) NOT NULL,
    tamano VARCHAR(30) NOT NULL,
    remitente_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    grupo_destino_id INT REFERENCES grupos(id) ON DELETE CASCADE,
    fecha_envio TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    estado VARCHAR(30) DEFAULT 'Enviado' -- 'Enviado', 'Bloqueado'
);

-- 10. TABLA: TICKETS
-- Mesa de ayuda institucional (Soporte DII) conectado al Dropzone de evidencias
CREATE TABLE tickets (
    id SERIAL PRIMARY KEY,
    area VARCHAR(100) NOT NULL, -- Área/Departamento reportado
    equipo_id VARCHAR(50) REFERENCES equipos(id) ON DELETE SET NULL,
    usuario_solicitante VARCHAR(150) NOT NULL,
    description TEXT NOT NULL,
    status VARCHAR(30) DEFAULT 'Abierto', -- 'Abierto', 'En proceso', 'Resuelto'
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 11. TABLA: EVIDENCIAS_TICKETS
-- Guarda las rutas en servidor/bucket de los archivos JPG, PNG, PDF adjuntados en FileUpload
CREATE TABLE evidencias_tickets (
    id SERIAL PRIMARY KEY,
    ticket_id INT REFERENCES tickets(id) ON DELETE CASCADE,
    ruta_archivo VARCHAR(500) NOT NULL, -- URL o path del storage local/bucket
    nombre_original VARCHAR(255) NOT NULL,
    tamano_mb NUMERIC(5,2),
    fecha_subida TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


